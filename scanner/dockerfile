# ==============================================================================
# BASE RUNNER : Environnement Python stable et léger
# ==============================================================================
FROM python:3.11-slim

# Évite les invites interactives pendant l'installation des paquets apt
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

# ==============================================================================
# ÉTAPE 1 : Dépendances système globales (Ne change presque jamais)
# ==============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    unzip \
    git \
    nmap \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ==============================================================================
# ÉTAPE 2 : Outils de sécurité (1 couche par outil)
# ==============================================================================
# Versions are pinned so builds are reproducible. To upgrade a tool, bump its
# version here (see https://github.com/projectdiscovery/<tool>/releases).
# An outdated nuclei silently skips newer templates, so keep it current.
ARG SUBFINDER_VERSION=2.17.0
ARG HTTPX_VERSION=1.12.0
ARG KATANA_VERSION=1.8.0
ARG NUCLEI_VERSION=3.11.1

# Downloads <tool>_<version>_linux_amd64.zip from the tool's GitHub release
# and installs the binary as /usr/local/bin/<name>.
RUN printf '%s\n' '#!/bin/sh' 'set -eu' \
      'tool="$1"; version="$2"; name="${3:-$1}"' \
      'url="https://github.com/projectdiscovery/${tool}/releases/download/v${version}/${tool}_${version}_linux_amd64.zip"' \
      'tmp="$(mktemp -d)"' \
      'curl -fsSL "$url" -o "$tmp/t.zip"' \
      'unzip -q -o "$tmp/t.zip" -d "$tmp"' \
      'install -m 0755 "$tmp/${tool}" "/usr/local/bin/${name}"' \
      'rm -rf "$tmp"' \
      'echo "installed ${name} v${version}"' \
      > /usr/local/bin/pd-install && chmod +x /usr/local/bin/pd-install

# --- COUCHE : SUBFINDER ---
RUN pd-install subfinder "$SUBFINDER_VERSION"

# --- COUCHE : HTTPX (ProjectDiscovery) ---
# Installed as httpx-toolkit to avoid a clash with the "httpx" pip package (like on Kali).
RUN pd-install httpx "$HTTPX_VERSION" httpx-toolkit

# --- COUCHE : KATANA ---
RUN pd-install katana "$KATANA_VERSION"

# --- COUCHE : FEROXBUSTER ---
RUN curl -sL https://raw.githubusercontent.com/epi052/feroxbuster/master/install-nix.sh | bash -s /usr/local/bin

# --- COUCHE : NUCLEI ---
RUN pd-install nuclei "$NUCLEI_VERSION"

# --- COUCHE : TEMPLATES NUCLEI ---
# On pré-télécharge les templates de vulnérabilités pour éviter que le conteneur 
# ne perde du temps à le faire à chaque démarrage de scan au runtime.
RUN nuclei -update-templates

# ==============================================================================
# ÉTAPE 3 : Dépendances de l'application Python (Déclenchée si requirements.txt change)
# ==============================================================================
WORKDIR /app

# On copie UNIQUEMENT le fichier des dépendances d'abord
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ==============================================================================
# ÉTAPE 4 : Code source (La couche la plus instable, placée tout en bas)
# ==============================================================================
# Puisque votre code change souvent pendant le dev, Docker ne reconstruira que cette couche.
# Note: wordlists/common.txt est inclus ici ; feroxbuster.py le resout via un chemin relatif au projet.
COPY . .

# The API listens on $PORT when the host provides one (e.g. Render),
# otherwise on 8000 (matches the frontend's NEXT_PUBLIC_API_URL default).
EXPOSE 8000

CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]
