# Copy to ".env" and fill in your own key to enable the AI remediation advisor.
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash

# --- Only needed when deploying to a cloud host (see DEPLOY.md) ---
# Scanner API (AWS server, written by deploy/aws/setup.sh):
# MONGODB_URL=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# REDIS_URL=rediss://default:pass@xxxxx.upstash.io:6379
# ALLOWED_ORIGINS=https://your-app.vercel.app
# NMAP_EXTRA_ARGS=--unprivileged
# NUCLEI_EXTRA_ARGS=-c 5 -bs 5 -rl 50
# Frontend (Vercel, used at build time):
# NEXT_PUBLIC_API_URL=https://1-2-3-4.sslip.io
